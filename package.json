{
  "name": "haccp-control-mobile",
  "version": "1.0.1",
  "private": true,
  "description": "Native Android shell for HACCP Control v3.9.2.1",
  "scripts": {
    "android:add": "npx cap add android",
    "android:sync": "npm run mobile:runtime && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "cap:doctor": "npx cap doctor",
    "mobile:runtime": "powershell -ExecutionPolicy Bypass -File ./scripts/build-mobile-runtime.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "html2pdf.js": "^0.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
